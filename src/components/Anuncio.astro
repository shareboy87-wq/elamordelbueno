---
import { SITIO } from '../consts';

interface Props {
  ranura?: string;
}
const { ranura } = Astro.props;
---

{
  SITIO.adsense && ranura ? (
    <div class="anuncio">
      <ins
        class="adsbygoogle"
        style="display:block;width:100%"
        data-ad-client={SITIO.adsense}
        data-ad-slot={ranura}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  ) : (
    <div class="anuncio">
      <div class="anuncio-vacio">Espacio de anuncio</div>
    </div>
  )
}
